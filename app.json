{
  "expo": {
    "name": "Notelo",
    "slug": "Notelo",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": [
      "notelo"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#bdc9c3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dev007pravesh.Notelo",
      "buildNumber": "5",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Notelo to take photos to attach to your notes.",
        "NSPhotoLibraryUsageDescription": "Allow Notelo to select photos to attach to your notes.",
        "NSMicrophoneUsageDescription": "Allow Notelo to record audio for voice notes.",
        "NSFaceIDUsageDescription": "Allow Notelo to unlock your private notes with Face ID."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.dev007pravesh.Notelo",
      "versionCode": 5,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Notelo to access your photos to attach images to notes."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Notelo to access your microphone for voice memos."
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "a7eed044-4ade-4ea7-b953-c1b80442f50b"
      }
    },
    "owner": "dev007pravesh"
  }
}
